// src/moon.pkg —— moonbit-eigen 的包配置
//
// 每一条取舍都有出处，详见 docs/PITFALLS.md。

import {
  // core 的普通包需要显式 import —— 连 moonbitlang/core 自己的包
  // （如 double/moon.pkg）都写了这一行，否则会触发
  // core_package_not_imported 警告（警告 id 71）。
  // 我们的代码用到 Array / FixedArray / String / Result / abort 等 builtin 内容。
  "moonbitlang/core/builtin",

  // C 侧返回 UTF-8 字节，MoonBit 侧解码，需要 @utf8 别名。
  "moonbitlang/core/encoding/utf8",
}

// ⚠️ 必须显式声明为库包。
// 实测：不写 pkgtype 时，moon build --target native 会尝试把本包链接成
// src.exe，而库包没有 main，导致：
//     libcmt.lib(exe_main.obj) : error LNK2019: 无法解析的外部符号 main
//     src.exe : fatal error LNK1120: 1 个无法解析的外部命令
// 这与 moon issue #637（native 下 run/test 需要互相矛盾的 linker 配置、
// 报 undefined reference to main）属于同一类问题。
pkgtype(kind: "library")

options(
  // ── Plan A：把 C++ 胶水作为 native-stub 交给 moon 编译 ──────────────────
  // ⚠️ 官方把 native-stub 定义为 "C stub source files"，对 .cpp 没有明文保证。
  //    这是本项目第 1 周技术穿刺要验证的第一件事。
  //
  // Plan B（若 Plan A 失败）：改成用脚本先把 eigen_shim.cpp 编成静态库，
  //    再用 cc-link-flags 链接进来。唯一的 C++ 真实先例
  //    （illusory0x0/qpainter）走的就是这条路：
  //    pre-build + Makefile + "-Lbuild -lqpainter_mbt -lstdc++"。
  //    代价是多维护一套构建，好处是不依赖未被官方承诺的行为。
  //    详见 docs/ROADMAP.md 的熔断点。
  "native-stub": [ "eigen_shim.cpp" ],

  // ── 不用 supported-targets: ["native"] ────────────────────────────────
  // 官方 agent skill 明确劝阻该写法：它会阻止下游包在其它后端构建。
  // 正确做法是用 targets 只把 FFI 声明文件限制在 native，
  // 这样纯 MoonBit 的部分（API 层、格式化、测试）在其它后端仍可编译。
  targets: { "ffi.mbt": [ "native" ] },

  // ── 编译器配置 ────────────────────────────────────────────────────────
  // 刻意**不设置 cc / stub-cc**，让 moon 自己发现工具链。
  //
  // 原因：Windows 上 moon 要求 "MSVC Build Tools with C++ tools and Windows SDK"，
  // 并用 find-msvc-tools 自动发现（moon PR #1866）。硬编码 clang-cl 会让
  // "装了 MSVC C++ 工作负载但没装 LLVM" 的机器直接失败 —— 本机正是这种情况
  // （见 docs/DECISIONS.md D13）。官方 agent skill 也建议不要设 cc：
  // 它会禁用 debug 构建的 TCC 加速。
  //
  // 若你改用 LLVM 的 clang-cl（而不是 MSVC 工作负载），把这两行加回来：
  //   "cc": "clang-cl",  "stub-cc": "clang-cl",
  //
  // cc-flags 里**不放任何路径**：Eigen 用相对包含引入（见 eigen_shim.hpp），
  // 从而不受 issue #586（cc-flags 按 pwd 解析）影响。
  link: {
    "native": {
      // ── 关于 /std: 的重要教训（实测命令行得出，详见 docs/PITFALLS.md）───
      // moon 给 stub 的默认命令行**已经带了 /std:c11**：
      //   cl /Fo...obj /I<moon include> /Z7 /c /std:c11 /nologo <stub.cpp> <本字段> /MT
      // 而 cc-flags 与 stub-cc-flags 的语义不同：
      //   · cc-flags      —— 替换默认值，作用于所有源文件（含 moonc 生成的 C）
      //   · stub-cc-flags —— 追加到默认值之后，只作用于 stub
      // 所以**两处都不能写 /std:**，否则命令行上会出现两个 /std: → cl error D8016。
      // 正确做法是不指定标准版本，让 cl 按扩展名自己选
      // （.c 走 C，.cpp 走 MSVC 默认的 C++14 —— Eigen 3.4 要求 C++14，够用）。
      //
      // /EHsc  : 开启标准 C++ 异常展开语义（Eigen 断言与 std::exception 需要）
      // /utf-8 : 让 MSVC 按 UTF-8 解释源文件。**不能省** —— 中文 Windows 上默认
      //          按 GBK，stub 里的中文字面量会以 GBK 进入程序，而 MoonBit 侧按
      //          UTF-8 解码 → 错误信息变乱码。
      // /bigobj: Eigen 模板展开产生大量 COMDAT 段，MSVC 系需要它
      // /O1    : 压低优化级别以控制模板编译时间
      // 这几个 flag cl.exe 与 clang-cl 都认。
      "stub-cc-flags": "/EHsc /utf-8 /bigobj /O1",
      // cl.exe 走 MSVC ABI，C++ 运行时随驱动自动链接。
      // Linux 上需改成 "-lstdc++"（GCC 驱动不会自动链接 libstdc++），
      // 同时 stub-cc-flags 也要换成 GCC 语法。详见 README 的「前置依赖」一节：
      // 本项目只在 Windows/MSVC 上做过完整的构建与运行验证。
      "cc-link-flags": "",
    },
  },
)
