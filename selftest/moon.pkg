// selftest/moon.pkg —— FFI 机制自检包
//
// 为什么要单独搞一个自检包？
//
// 本项目的技术风险其实是**两件独立的事**：
//   A. MoonBit 的 native FFI 机制能不能用 —— .cpp 能否作 native-stub、
//      #borrow 是否生效、moonbit_make_external_object 的 finalizer 会不会跑、
//      moonbit_make_bytes + @utf8.decode_lossy 的编码往返是否正确；
//   B. 具体某个第三方库（Eigen）能不能编译链接。
//
// 如果只做 src/ 那一个包，A 和 B 会耦合在一起：Eigen 下载不下来（本机网络不稳），
// 就连 A 也验证不了。这个包把 A 单独拎出来，**不需要任何第三方依赖、不需要网络**，
// 只要 C++ 工具链就位就能给出 A 的结论。
//
// 如果 A 失败，那么 Plan A/B 的判定与 Eigen 无关，可以直接下结论。

import {
  "moonbitlang/core/builtin",
  "moonbitlang/core/encoding/utf8",
}

// ⚠️ 必须显式声明为库包（理由见 src/moon.pkg 的注释）：
// 否则 moon build --target native 会尝试链接 selftest.exe，
// 而库包没有 main → LNK2019: 无法解析的外部符号 main。
pkgtype(kind: "library")

options(
  "native-stub": [ "smoke_stub.cpp" ],

  targets: { "smoke_ffi.mbt": [ "native" ] },

  link: {
    "native": {
      // ── 关于 /std: 的重要教训（实测命令行得出）─────────────────────────
      // moon 给 stub 的默认命令行里**已经带了 /std:c11**：
      //   cl /Fo...obj /I<moon include> /Z7 /c /std:c11 /nologo <stub.cpp> <本字段> /MT
      // 而 cc-flags / stub-cc-flags 的语义不同：
      //   · cc-flags      —— 替换默认值，作用于所有源文件（含 moonc 生成的 C）
      //   · stub-cc-flags —— 追加到默认值之后，只作用于 stub
      // 因此**两处都不能出现 /std:**：
      //   放 cc-flags      → 生成的 .c 文件会同时拿到 /std:c11 和 /std:c++17，报 D8016
      //   放 stub-cc-flags → stub 命令行上同样两个 /std: 并存，报 D8016
      // 正确做法是不指定标准版本，让 cl 按扩展名自己选
      // （.c 走 C，.cpp 走 MSVC 默认的 C++14 —— Eigen 3.4 要求 C++14，够用）。
      //
      // /EHsc  : 开启标准 C++ 异常展开语义（缺了报 warning C4530）
      // /utf-8 : 让 MSVC 按 UTF-8 解释源文件。不能省 —— 中文 Windows 上默认按
      //          GBK，stub 里的中文字面量会以 GBK 进入程序，而 MoonBit 侧按
      //          UTF-8 解码 → 错误信息变乱码。
      // /bigobj: 模板展开产生大量 COMDAT 段（Eigen 尤其需要）
      // /O1    : 压低优化级别以控制模板编译时间
      "stub-cc-flags": "/EHsc /utf-8 /bigobj /O1",
      "cc-link-flags": "",
    },
  },
)
